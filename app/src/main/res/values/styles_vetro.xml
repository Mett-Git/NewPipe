<?xml version="1.0" encoding="utf-8"?>
<!-- Stili del "Vetro" (vedi colors_vetro.xml). -->
<resources>
    <!-- nomi delle schede nella barra in basso -->
    <style name="VetroTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">10.5sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- tasti a pillola sotto il video (Finestrella, Audio, Scarica...) -->
    <style name="VetroPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/vetro_pill</item>
        <item name="android:stateListAnimator">@animator/vetro_press</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- la pillola in evidenza: corallo -->
    <style name="VetroPill.Hot">
        <item name="android:background">@drawable/vetro_pill_hot</item>
        <item name="android:textColor">@color/vetro_pill_hot_text</item>
        <item name="drawableTint">@color/vetro_pill_hot_text</item>
    </style>

    <!-- voci del menu a sinistra: a pillola -->
    <style name="VetroDrawerItemShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- schede della pagina del canale -->
    <style name="VetroChannelTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- titoletti del menu a sinistra -->
    <style name="VetroDrawerLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- finestre di dialogo nei temi scuro e nero: vetro scuro arrotondato, tasti corallo -->
    <style name="VetroAlertDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/vetro_dialog_background</item>
        <item name="colorAccent">@color/vetro_coral</item>
        <item name="colorControlActivated">@color/vetro_coral</item>
    </style>

    <!-- la stessa finestra per il menu che esce tenendo premuto un video -->
    <style name="VetroSystemAlertDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/vetro_dialog_background</item>
        <item name="android:colorAccent">@color/vetro_coral</item>
    </style>

    <!-- menu a tendina -->
    <style name="VetroPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/vetro_popup_background</item>
    </style>

    <style name="VetroOverflowMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/vetro_popup_background</item>
    </style>
</resources>
