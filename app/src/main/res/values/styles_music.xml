<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- NewPipe Music è sempre scura, qualunque sia il tema del resto dell'app -->
    <style name="VetroMusicTheme" parent="BlackTheme">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="VetroMusicCover">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">9dp</item>
    </style>

    <style name="VetroMusicRound">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="VetroMusicCoverCard">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="VetroMusicCoverBig">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="VetroMusicTitle">
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/vm_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="VetroMusicSubtitle">
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/vm_text_soft</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="VetroMusicSection">
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/vm_text</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VetroMusicIcon">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">10dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/vm_text</item>
    </style>

    <style name="VetroMusicNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:stateListAnimator">@animator/vetro_press</item>
    </style>

    <style name="VetroMusicAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/vm_glass</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:stateListAnimator">@animator/vetro_press</item>
    </style>

    <style name="VetroMusicActionIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/vm_text</item>
    </style>

    <style name="VetroMusicActionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/vm_text_soft</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="VetroMusicNavIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="tint">@color/vm_nav</item>
    </style>

    <style name="VetroMusicNavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:textColor">@color/vm_nav</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
