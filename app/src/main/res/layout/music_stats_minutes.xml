<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:layout_weight="1"
        android:background="@drawable/vm_glass_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/musicStatsMinutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/vm_accent"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            style="@style/VetroMusicSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="@string/vm_minutes_short" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:layout_weight="1"
        android:background="@drawable/vm_glass_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/musicStatsSongs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/vm_text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            style="@style/VetroMusicSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="@string/vm_songs_played" />
    </LinearLayout>
</LinearLayout>
