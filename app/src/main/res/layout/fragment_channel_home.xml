<?xml version="1.0" encoding="utf-8"?>
<!-- La scheda "Home" del canale: video in evidenza e sezioni (ChannelHomeFragment). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/channelHomeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="140dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/channelHomeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp" />
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/channelHomeLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="60dp"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/channelHomeEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="60dp"
        android:text="@string/empty_list_subtitle"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone" />
</FrameLayout>
