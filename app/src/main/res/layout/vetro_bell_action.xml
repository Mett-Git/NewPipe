<?xml version="1.0" encoding="utf-8"?>
<!-- Campanella in alto accanto alla ricerca, col numero dei video nuovi dei canali seguiti. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="@string/vt_bell"
    android:focusable="true">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_notifications"
        app:tint="?attr/colorControlNormal" />

    <TextView
        android:id="@+id/vetro_bell_badge"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_gravity="center"
        android:layout_marginStart="9dp"
        android:layout_marginBottom="11dp"
        android:background="@drawable/vetro_bell_badge"
        android:gravity="center"
        android:minWidth="16dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="#000000"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
