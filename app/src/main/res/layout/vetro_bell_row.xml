<?xml version="1.0" encoding="utf-8"?>
<!-- Una riga dell'elenco della campanella: pallino, miniatura, canale e titolo, quando. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <View
        android:id="@+id/vetro_bell_row_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/vetro_bell_dot" />

    <ImageView
        android:id="@+id/vetro_bell_row_thumb"
        android:layout_width="96dp"
        android:layout_height="54dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/vetro_bell_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/vetro_bell_row_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11.5sp" />
    </LinearLayout>

</LinearLayout>
