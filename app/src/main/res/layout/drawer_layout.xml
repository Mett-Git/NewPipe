<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.navigation.NavigationView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigation"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@drawable/vetro_drawer_background"
    android:orientation="vertical"
    app:headerLayout="@layout/drawer_header"
    app:itemIconTint="@color/vetro_drawer_item_content"
    app:itemShapeAppearance="@style/VetroDrawerItemShape"
    app:itemShapeFillColor="@color/vetro_drawer_item_fill"
    app:itemShapeInsetEnd="12dp"
    app:itemShapeInsetStart="12dp"
    app:insetForeground="@android:color/transparent"
    app:itemTextColor="@color/vetro_drawer_item_content" />
