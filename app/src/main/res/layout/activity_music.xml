<?xml version="1.0" encoding="utf-8"?>
<!-- NewPipe Music: le pagine, sopra barra e mini lettore, sopra il lettore, sopra l'intro. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vm_glow">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/musicPages"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/musicBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/musicMini"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/vm_bar"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/musicMiniCover"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@color/vm_glass"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/VetroMusicCover" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/musicMiniTitle"
                        style="@style/VetroMusicTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/musicMiniArtist"
                        style="@style/VetroMusicSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/musicMiniPlay"
                    style="@style/VetroMusicIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/vm_play"
                    android:src="@drawable/ic_play_arrow" />

                <ImageView
                    android:id="@+id/musicMiniNext"
                    style="@style/VetroMusicIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/vm_next"
                    android:src="@drawable/ic_next" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/musicMiniProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="3dp"
                android:progressBackgroundTint="@color/vm_glass_stroke"
                android:progressTint="@color/vm_accent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/vm_bar"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/musicNavHome"
                style="@style/VetroMusicNavItem">

                <ImageView
                    style="@style/VetroMusicNavIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_home" />

                <TextView
                    style="@style/VetroMusicNavLabel"
                    android:text="@string/vm_home" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/musicNavExplore"
                style="@style/VetroMusicNavItem">

                <ImageView
                    style="@style/VetroMusicNavIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_explore" />

                <TextView
                    style="@style/VetroMusicNavLabel"
                    android:text="@string/vm_explore" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/musicNavLibrary"
                style="@style/VetroMusicNavItem">

                <ImageView
                    style="@style/VetroMusicNavIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_vm_library" />

                <TextView
                    style="@style/VetroMusicNavLabel"
                    android:text="@string/vm_library" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/musicPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vm_glow"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:visibility="invisible">

        <View
            android:id="@+id/musicPlayerTint"
            android:layout_width="match_parent"
            android:layout_height="440dp" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/musicPlayerContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp">

                <LinearLayout
                    android:id="@+id/musicPlayerHeader"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/musicPlayerClose"
                        style="@style/VetroMusicIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="-10dp"
                        android:contentDescription="@string/close"
                        android:src="@drawable/ic_expand_more" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/vm_now_playing"
                        android:textColor="@color/vm_text_soft"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/musicPlayerLike"
                        style="@style/VetroMusicIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="-10dp"
                        android:contentDescription="@string/vm_like"
                        android:src="@drawable/ic_vm_favorite_border" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/musicPlayerCoverBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/vm_cover_glow"
                    android:padding="18dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/musicPlayerCover"
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:background="@color/vm_glass"
                        android:contentDescription="@string/vm_now_playing"
                        android:scaleType="centerCrop"
                        app:shapeAppearance="@style/VetroMusicCoverBig" />
                </FrameLayout>

                <TextView
                    android:id="@+id/musicPlayerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/vm_text"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/musicPlayerArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/vm_text_soft"
                    android:textSize="15sp" />

                <SeekBar
                    android:id="@+id/musicPlayerSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-16dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="-16dp"
                    android:progressBackgroundTint="@color/vm_glass_stroke"
                    android:progressTint="@color/vm_accent"
                    android:secondaryProgressTint="@color/vm_text_faint"
                    android:splitTrack="false"
                    android:thumbTint="@color/vm_accent" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/musicPlayerNow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/vm_text_soft"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/musicPlayerEnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="0:00"
                        android:textColor="@color/vm_text_soft"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/musicPlayerShuffle"
                        style="@style/VetroMusicIcon"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/vm_shuffle"
                        android:src="@drawable/ic_shuffle" />

                    <ImageView
                        android:id="@+id/musicPlayerPrevious"
                        style="@style/VetroMusicIcon"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/vm_previous"
                        android:src="@drawable/ic_previous" />

                    <FrameLayout
                        android:layout_width="68dp"
                        android:layout_height="68dp">

                        <ImageView
                            android:id="@+id/musicPlayerPlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/vm_play_button"
                            android:contentDescription="@string/vm_play"
                            android:padding="17dp"
                            android:src="@drawable/ic_play_arrow"
                            android:stateListAnimator="@animator/vetro_press"
                            app:tint="#000000" />

                        <ProgressBar
                            android:id="@+id/musicPlayerLoading"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminateTint="#66000000"
                            android:visibility="gone" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/musicPlayerNext"
                        style="@style/VetroMusicIcon"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/vm_next"
                        android:src="@drawable/ic_next" />

                    <ImageView
                        android:id="@+id/musicPlayerRepeat"
                        style="@style/VetroMusicIcon"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/vm_repeat"
                        android:src="@drawable/ic_repeat" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/vm_glass"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/musicActionSpeed"
                        style="@style/VetroMusicAction">

                        <TextView
                            android:id="@+id/musicActionSpeedValue"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:gravity="center"
                            android:text="1x"
                            android:textColor="@color/vm_text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/musicActionSpeedLabel"
                            style="@style/VetroMusicActionLabel"
                            android:text="@string/vm_speed" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/musicActionLyrics"
                        style="@style/VetroMusicAction">

                        <ImageView
                            style="@style/VetroMusicActionIcon"
                            android:src="@drawable/ic_vm_lyrics" />

                        <TextView
                            android:id="@+id/musicActionLyricsLabel"
                            style="@style/VetroMusicActionLabel"
                            android:text="@string/vm_lyrics" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/musicActionTimer"
                        style="@style/VetroMusicAction">

                        <ImageView
                            style="@style/VetroMusicActionIcon"
                            android:src="@drawable/ic_vm_timer" />

                        <TextView
                            android:id="@+id/musicActionTimerLabel"
                            style="@style/VetroMusicActionLabel"
                            android:text="@string/vm_timer" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/musicActionEqualizer"
                        style="@style/VetroMusicAction">

                        <ImageView
                            style="@style/VetroMusicActionIcon"
                            android:src="@drawable/ic_vm_equalizer" />

                        <TextView
                            android:id="@+id/musicActionEqualizerLabel"
                            style="@style/VetroMusicActionLabel"
                            android:text="@string/vm_equalizer_short" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/musicActionMore"
                        style="@style/VetroMusicAction">

                        <ImageView
                            style="@style/VetroMusicActionIcon"
                            android:src="@drawable/ic_more_vert" />

                        <TextView
                            android:id="@+id/musicActionMoreLabel"
                            style="@style/VetroMusicActionLabel"
                            android:text="@string/vm_more" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/musicPlayerQueueLabel"
                        style="@style/VetroMusicSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="0dp"
                        android:text="@string/vm_up_next"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/musicPlayerQueueEdit"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginTop="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/vm_edit_queue"
                        android:textColor="@color/vm_accent"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/musicPlayerQueue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-12dp"
                    android:layout_marginEnd="-12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/musicPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vm_glow"
        android:clickable="true"
        android:elevation="14dp"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/musicPanelClose"
                style="@style/VetroMusicIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_expand_more" />

            <TextView
                android:id="@+id/musicPanelTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/vm_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/musicPanelAction"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/vm_clear_queue"
                android:textColor="@color/vm_accent"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/musicPanelBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/musicIntro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/musicIntroLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:src="@drawable/splash_foreground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="NewPipe"
                android:textColor="@color/vm_text"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <TextView
            android:id="@+id/musicIntroLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.32"
            android:text="MUSIC"
            android:textColor="@color/vm_accent"
            android:textSize="34sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</FrameLayout>
