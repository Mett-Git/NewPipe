<?xml version="1.0" encoding="utf-8"?>
<!-- Finestra "Modifica profilo": nome, colore, foto e copertina (VetroProfile). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="12dp"
    android:paddingEnd="22dp">

    <EditText
        android:id="@+id/profileEditName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/vt_profile_name_hint"
        android:importantForAutofill="no"
        android:inputType="textPersonName|textCapWords"
        android:maxLength="40"
        android:singleLine="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/vt_profile_color"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/profileEditColors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/profileEditPhoto"
                style="@style/VetroPill"
                android:text="@string/vt_profile_photo" />

            <TextView
                android:id="@+id/profileEditCover"
                style="@style/VetroPill"
                android:text="@string/vt_profile_cover" />

            <TextView
                android:id="@+id/profileEditReset"
                style="@style/VetroPill"
                android:text="@string/vt_profile_remove_images" />
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
