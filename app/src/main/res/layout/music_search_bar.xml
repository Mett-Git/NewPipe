<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="10dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/vm_search_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/musicSearchBack"
        style="@style/VetroMusicIcon"
        android:layout_width="46dp"
        android:layout_height="50dp"
        android:layout_marginStart="2dp"
        android:contentDescription="@string/vm_back"
        android:src="@drawable/ic_arrow_back" />

    <EditText
        android:id="@+id/musicSearchField"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_weight="1"
        android:background="@null"
        android:hint="@string/vm_search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/vm_text"
        android:textColorHint="@color/vm_text_faint"
        android:textCursorDrawable="@null"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/musicSearchClear"
        style="@style/VetroMusicIcon"
        android:layout_width="46dp"
        android:layout_height="50dp"
        android:layout_marginEnd="2dp"
        android:contentDescription="@string/vm_clear"
        android:src="@drawable/ic_close"
        android:visibility="gone" />
</LinearLayout>
