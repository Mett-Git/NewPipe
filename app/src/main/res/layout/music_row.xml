<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="7dp"
    android:background="@drawable/vm_glass"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="7dp"
    android:paddingEnd="2dp"
    android:paddingBottom="7dp"
    android:stateListAnimator="@animator/vetro_press_soft">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/musicRowCover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@color/vm_glass"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/VetroMusicCover" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/musicRowTitle"
            style="@style/VetroMusicTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/musicRowSubtitle"
            style="@style/VetroMusicSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp" />

        <TextView
            android:id="@+id/musicRowBadge"
            style="@style/VetroMusicSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/vm_accent"
            android:visibility="gone" />
    </LinearLayout>

    <org.schabi.newpipe.music.MusicBars
        android:id="@+id/musicRowBars"
        android:layout_width="18dp"
        android:layout_height="16dp"
        android:layout_marginEnd="14dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/musicRowMore"
        style="@style/VetroMusicIcon"
        android:layout_width="40dp"
        android:layout_height="44dp"
        android:contentDescription="@string/vm_more"
        android:src="@drawable/ic_more_vert" />
</LinearLayout>
