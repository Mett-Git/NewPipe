<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/musicListBack"
            style="@style/VetroMusicIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/vm_back"
            android:src="@drawable/ic_arrow_back" />

        <!-- quando non c'è copertina il titolo sta qui, accanto alla freccia -->
        <TextView
            android:id="@+id/musicListBarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/vm_text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/musicListTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/musicListCover"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:background="@color/vm_glass"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/VetroMusicCoverCard" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/musicListTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/vm_text"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/musicListSubtitle"
                style="@style/VetroMusicSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/musicListCount"
                style="@style/VetroMusicSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/musicListButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/musicListPlay"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/vm_pill_accent"
            android:clickable="true"
            android:drawablePadding="6dp"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:stateListAnimator="@animator/vetro_press"
            android:text="@string/vm_play"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_play_arrow"
            app:drawableTint="#000000" />

        <TextView
            android:id="@+id/musicListShuffle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/vm_glass_pill"
            android:clickable="true"
            android:drawablePadding="6dp"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:stateListAnimator="@animator/vetro_press"
            android:text="@string/vm_shuffle"
            android:textColor="@color/vm_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_shuffle"
            app:drawableTint="@color/vm_text" />

        <TextView
            android:id="@+id/musicListExtra"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/vm_glass_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:stateListAnimator="@animator/vetro_press"
            android:textColor="@color/vm_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/musicListAddAll"
            style="@style/VetroMusicIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/vm_glass_pill"
            android:contentDescription="@string/vm_add_all"
            android:src="@drawable/ic_playlist_add"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
