<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/musicListBack"
        style="@style/VetroMusicIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start"
        android:layout_marginStart="2dp"
        android:contentDescription="@string/vm_back"
        android:src="@drawable/ic_arrow_back" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/musicListCover"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:background="@color/vm_glass"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/VetroMusicCoverBig" />

    <TextView
        android:id="@+id/musicListTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/vm_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/musicListSubtitle"
        style="@style/VetroMusicSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/musicListButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/musicListPlay"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/vm_pill_accent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:stateListAnimator="@animator/vetro_press"
            android:text="@string/vm_play"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/musicListShuffle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/vm_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:stateListAnimator="@animator/vetro_press"
            android:text="@string/vm_shuffle"
            android:textColor="@color/vm_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/musicListExtra"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/vm_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:stateListAnimator="@animator/vetro_press"
            android:textColor="@color/vm_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/musicListAddAll"
            style="@style/VetroMusicIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/vm_glass"
            android:contentDescription="@string/vm_add_all"
            android:src="@drawable/ic_playlist_add"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
