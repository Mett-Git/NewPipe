<?xml version="1.0" encoding="utf-8"?>
<!-- Tasti sopra le liste di video (canale, playlist, cronologia): pillole di vetro. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp"
    android:visibility="invisible"
    tools:visibility="visible">

    <LinearLayout
        android:id="@+id/playlist_ctrl_play_all_button"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:layout_weight="1.25"
        android:background="@drawable/vetro_pill_hot"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:stateListAnimator="@animator/vetro_press">

        <org.schabi.newpipe.views.NewPipeTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/vetro_pill_ic_play_all"
            android:drawablePadding="5dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="@string/play_all"
            android:textColor="@color/vetro_pill_hot_text"
            android:textSize="13sp"
            android:textStyle="bold"
            app:drawableTint="@color/vetro_pill_hot_text"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playlist_ctrl_play_bg_button"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:layout_weight="1"
        android:background="@drawable/vetro_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:stateListAnimator="@animator/vetro_press">

        <org.schabi.newpipe.views.NewPipeTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/vetro_pill_ic_headset"
            android:drawablePadding="5dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="@string/pill_audio"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playlist_ctrl_play_popup_button"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:layout_weight="1"
        android:background="@drawable/vetro_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:stateListAnimator="@animator/vetro_press">

        <org.schabi.newpipe.views.NewPipeTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/vetro_pill_ic_pip"
            android:drawablePadding="5dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="@string/controls_popup_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
