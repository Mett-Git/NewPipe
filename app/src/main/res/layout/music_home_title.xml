<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="6dp">

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        android:src="@drawable/splash_foreground" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:text="NewPipe"
        android:textColor="@color/vm_text"
        android:textSize="19sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:fontFamily="sans-serif-light"
        android:letterSpacing="0.2"
        android:text="MUSIC"
        android:textColor="@color/vm_accent"
        android:textSize="14sp"
        tools:ignore="HardcodedText" />

    <ImageView
        android:id="@+id/musicPageSearch"
        style="@style/VetroMusicIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/vm_search"
        android:src="@drawable/ic_search" />
</LinearLayout>
