<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="130dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="10dp"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:stateListAnimator="@animator/vetro_press_soft">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/musicCardCover"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:background="@color/vm_glass"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/VetroMusicCoverCard" />

    <TextView
        android:id="@+id/musicCardTitle"
        style="@style/VetroMusicTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp" />

    <TextView
        android:id="@+id/musicCardSubtitle"
        style="@style/VetroMusicSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
