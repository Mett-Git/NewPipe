<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="380dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/musicArtistCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/vm_glass"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/vm_artist_fade" />

        <ImageView
            android:id="@+id/musicArtistBack"
            style="@style/VetroMusicIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/vm_back"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/musicArtistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/vm_text"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/musicArtistFollowers"
                style="@style/VetroMusicSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/musicArtistFollow"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/vm_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="88dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:stateListAnimator="@animator/vetro_press"
            android:textColor="@color/vm_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/musicArtistShuffle"
            style="@style/VetroMusicIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/vm_shuffle"
            android:src="@drawable/ic_shuffle" />

        <ImageView
            android:id="@+id/musicArtistPlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/vm_play_button"
            android:clickable="true"
            android:contentDescription="@string/vm_play"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_play_arrow"
            android:stateListAnimator="@animator/vetro_press"
            app:tint="#000000" />
    </LinearLayout>
</LinearLayout>
