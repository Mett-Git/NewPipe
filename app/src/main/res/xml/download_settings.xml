<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/settings_category_downloads_title">

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/vt_cat_where"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">

        <Preference
            android:dialogTitle="@string/download_path_dialog_title"
            android:key="@string/download_path_video_key"
            android:summary="@string/vs_download_path_video_key"
            android:title="@string/vt_download_path_video_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <Preference
            android:dialogTitle="@string/download_path_audio_dialog_title"
            android:key="@string/download_path_audio_key"
            android:summary="@string/vs_download_path_audio_key"
            android:title="@string/vt_download_path_audio_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/downloads_storage_ask"
            android:summary="@string/vs_downloads_storage_ask"
            android:title="@string/vt_downloads_storage_ask"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/vt_cat_how"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/downloads_queue_limit"
            android:summary="@string/vs_downloads_queue_limit"
            android:title="@string/vt_downloads_queue_limit"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/downloads_cross_network"
            android:summary="@string/vs_downloads_cross_network"
            android:title="@string/vt_downloads_cross_network"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:defaultValue="@string/downloads_maximum_retry_default"
            android:entries="@array/downloads_maximum_retry_list"
            android:entryValues="@array/downloads_maximum_retry_list"
            android:key="@string/downloads_maximum_retry"
            android:summary="@string/vs_downloads_maximum_retry"
            android:title="@string/vt_downloads_maximum_retry"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/vt_cat_advanced"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/storage_use_saf"
            android:summary="@string/vs_storage_use_saf"
            android:title="@string/vt_storage_use_saf"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:defaultValue="@string/default_file_charset_value"
            android:entries="@array/settings_filename_charset_name"
            android:entryValues="@array/settings_filename_charset"
            android:key="@string/settings_file_charset_key"
            android:summary="@string/vs_settings_file_charset_key"
            android:title="@string/vt_settings_file_charset_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:defaultValue="@string/settings_file_replacement_character_default_value"
            android:key="@string/settings_file_replacement_character_key"
            android:summary="@string/vs_settings_file_replacement_character_key"
            android:title="@string/vt_settings_file_replacement_character_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>
</PreferenceScreen>
