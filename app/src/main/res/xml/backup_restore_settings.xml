<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/settings_category_backup_restore_title">

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/vt_cat_full"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">

        <Preference
            android:key="@string/export_data"
            android:summary="@string/vs_export_data"
            android:title="@string/vt_export_data"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="@string/import_data"
            android:summary="@string/vs_import_data"
            android:title="@string/vt_import_data"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/vt_cat_subs"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">

        <Preference
            android:key="@string/export_subscriptions_key"
            android:title="@string/vt_export_subscriptions_key"
            android:summary="@string/vs_export_subscriptions_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="@string/import_subscriptions_key"
            android:title="@string/vt_import_subscriptions_key"
            android:summary="@string/vs_import_subscriptions_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/vt_cat_reset"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">

        <Preference
            android:key="@string/reset_settings"
            android:title="@string/vt_reset_settings"
            android:summary="@string/vs_reset_settings"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>
</PreferenceScreen>
