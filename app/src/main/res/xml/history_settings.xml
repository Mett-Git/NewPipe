<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:key="general_preferences"
    android:title="@string/settings_category_history_title">

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/vt_cat_remember"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/enable_watch_history_key"
            android:summary="@string/vs_enable_watch_history_key"
            android:title="@string/vt_enable_watch_history_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/enable_search_history_key"
            android:summary="@string/vs_enable_search_history_key"
            android:title="@string/vt_enable_search_history_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:dependency="@string/enable_watch_history_key"
            android:key="@string/enable_playback_resume_key"
            android:summary="@string/vs_enable_playback_resume_key"
            android:title="@string/vt_enable_playback_resume_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:dependency="@string/enable_watch_history_key"
            android:key="@string/enable_playback_state_lists_key"
            android:summary="@string/vs_enable_playback_state_lists_key"
            android:title="@string/vt_enable_playback_state_lists_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/vt_cat_clear"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">

        <Preference
                android:key="@string/clear_views_history_key"
                android:summary="@string/vs_clear_views_history_key"
                android:title="@string/vt_clear_views_history_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="@string/clear_playback_states_key"
                android:summary="@string/vs_clear_playback_states_key"
                android:title="@string/vt_clear_playback_states_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="@string/clear_search_history_key"
                android:summary="@string/vs_clear_search_history_key"
                android:title="@string/vt_clear_search_history_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="@string/metadata_cache_wipe_key"
                android:summary="@string/vs_metadata_cache_wipe_key"
                android:title="@string/vt_metadata_cache_wipe_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="@string/clear_cookie_key"
                android:summary="@string/vs_clear_cookie_key"
                android:title="@string/vt_clear_cookie_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

    </PreferenceCategory>
</PreferenceScreen>
