<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/settings_category_video_audio_title">

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/vt_cat_quality"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">

        <ListPreference
            android:defaultValue="@string/default_resolution_value"
            android:entries="@array/resolution_list_description"
            android:entryValues="@array/resolution_list_values"
            android:key="@string/default_resolution_key"
            android:summary="@string/vs_default_resolution_key"
            android:title="@string/vt_default_resolution_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:defaultValue="@string/limit_mobile_data_usage_value"
            android:entries="@array/limit_data_usage_description_list"
            android:entryValues="@array/limit_data_usage_values_list"
            android:key="@string/limit_mobile_data_usage_key"
            android:summary="@string/vs_limit_mobile_data_usage_key"
            android:title="@string/vt_limit_mobile_data_usage_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:defaultValue="@string/default_popup_resolution_value"
            android:entries="@array/resolution_list_description"
            android:entryValues="@array/resolution_list_values"
            android:key="@string/default_popup_resolution_key"
            android:summary="@string/vs_default_popup_resolution_key"
            android:title="@string/vt_default_popup_resolution_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/show_higher_resolutions_key"
            android:summary="@string/vs_show_higher_resolutions_key"
            android:title="@string/vt_show_higher_resolutions_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/vt_cat_watching"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">

        <ListPreference
                android:defaultValue="@string/minimize_on_exit_value"
                android:entries="@array/minimize_on_exit_action_description"
                android:entryValues="@array/minimize_on_exit_action_key"
                android:key="@string/minimize_on_exit_key"
                android:summary="@string/vs_minimize_on_exit_key"
                android:title="@string/vt_minimize_on_exit_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <ListPreference
                android:defaultValue="@string/preferred_open_action_default"
                android:entries="@array/preferred_open_action_description_list"
                android:entryValues="@array/preferred_open_action_values_list"
                android:key="@string/preferred_open_action_key"
                android:summary="@string/vs_preferred_open_action_key"
                android:title="@string/vt_preferred_open_action_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <ListPreference
                android:defaultValue="@string/autoplay_value"
                android:entries="@array/autoplay_type_description"
                android:entryValues="@array/autoplay_type_key"
                android:key="@string/autoplay_key"
                android:summary="@string/vs_autoplay_key"
                android:title="@string/vt_autoplay_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="@string/auto_queue_key"
                android:summary="@string/vs_auto_queue_key"
                android:title="@string/vt_auto_queue_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="@string/start_main_player_fullscreen_key"
                android:summary="@string/vs_start_main_player_fullscreen_key"
                android:title="@string/vt_start_main_player_fullscreen_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="@string/resume_on_audio_focus_gain_key"
                android:summary="@string/vs_resume_on_audio_focus_gain_key"
                android:title="@string/vt_resume_on_audio_focus_gain_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/vt_cat_gestures"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">

        <ListPreference
                android:defaultValue="@string/default_left_gesture_control_value"
                android:entries="@array/left_gesture_control_description"
                android:entryValues="@array/left_gesture_control_values"
                android:key="@string/left_gesture_control_key"
                android:summary="@string/vs_left_gesture_control_key"
                android:title="@string/vt_left_gesture_control_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <ListPreference
                android:defaultValue="@string/default_right_gesture_control_value"
                android:entries="@array/right_gesture_control_description"
                android:entryValues="@array/right_gesture_control_values"
                android:key="@string/right_gesture_control_key"
                android:summary="@string/vs_right_gesture_control_key"
                android:title="@string/vt_right_gesture_control_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <ListPreference
                android:defaultValue="@string/seek_duration_default_value"
                android:entries="@array/seek_duration_description"
                android:entryValues="@array/seek_duration_value"
                android:key="@string/seek_duration_key"
                android:summary="@string/vs_seek_duration_key"
            android:title="@string/vt_seek_duration_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="@string/use_inexact_seek_key"
                android:summary="@string/vs_use_inexact_seek_key"
                android:title="@string/vt_use_inexact_seek_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <ListPreference
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:defaultValue="seekbar_preview_thumbnail_high_quality"
                android:entries="@array/seekbar_preview_thumbnail_type_description"
                android:entryValues="@array/seekbar_preview_thumbnail_type_key"
                android:key="@string/seekbar_preview_thumbnail_key"
                android:summary="@string/vs_seekbar_preview_thumbnail_key"
            android:title="@string/vt_seekbar_preview_thumbnail_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                android:defaultValue="true"
                android:key="@string/popup_remember_size_pos_key"
                android:summary="@string/vs_popup_remember_size_pos_key"
                android:title="@string/vt_popup_remember_size_pos_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="@string/clear_queue_confirmation_key"
                android:summary="@string/vs_clear_queue_confirmation_key"
                android:title="@string/vt_clear_queue_confirmation_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/vt_cat_audio"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/prefer_original_audio_key"
            android:summary="@string/vs_prefer_original_audio_key"
            android:title="@string/vt_prefer_original_audio_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false"/>

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/prefer_descriptive_audio_key"
            android:summary="@string/vs_prefer_descriptive_audio_key"
            android:title="@string/vt_prefer_descriptive_audio_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/vt_cat_advanced"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false">

        <ListPreference
            android:defaultValue="@string/default_video_format_value"
            android:entries="@array/video_format_description_list"
            android:entryValues="@array/video_format_values_list"
            android:key="@string/default_video_format_key"
            android:summary="@string/vs_default_video_format_key"
            android:title="@string/vt_default_video_format_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:defaultValue="@string/default_audio_format_value"
            android:entries="@array/audio_format_description_list"
            android:entryValues="@array/audio_format_values_list"
            android:key="@string/default_audio_format_key"
            android:summary="@string/vs_default_audio_format_key"
            android:title="@string/vt_default_audio_format_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="@string/use_external_video_player_key"
                android:summary="@string/vs_use_external_video_player_key"
                android:title="@string/vt_use_external_video_player_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="@string/use_external_audio_player_key"
                android:summary="@string/vs_use_external_audio_player_key"
            android:title="@string/vt_use_external_audio_player_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="@string/show_play_with_kodi_key"
                android:summary="@string/vs_show_play_with_kodi_key"
                android:title="@string/vt_show_play_with_kodi_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="@string/ignore_hardware_media_buttons_key"
                android:summary="@string/vs_ignore_hardware_media_buttons_key"
                android:title="@string/vt_ignore_hardware_media_buttons_key"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <PreferenceScreen
            android:fragment="org.schabi.newpipe.settings.ExoPlayerSettingsFragment"
            android:key="@string/exoplayer_settings_key"
            android:summary="@string/vs_exoplayer_settings_key"
            android:title="@string/vt_exoplayer_settings_key"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>
</PreferenceScreen>
