<?xml version="1.0" encoding="utf-8"?>
<!-- Riquadro di vetro toccabile (descrizione e commenti nella pagina del video). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/vetro_pill_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vetro_card_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/vetro_card_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
