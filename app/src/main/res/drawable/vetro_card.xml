<?xml version="1.0" encoding="utf-8"?>
<!-- Riquadro di vetro staccato dai bordi (commenti), con l'onda al tocco. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/vetro_pill_ripple">
    <item
        android:bottom="4dp"
        android:left="8dp"
        android:right="8dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/vetro_card_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/vetro_card_border" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
