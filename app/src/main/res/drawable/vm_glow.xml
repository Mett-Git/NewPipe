<?xml version="1.0" encoding="utf-8"?>
<!-- Lo sfondo di NewPipe Music: quasi nero con tre aloni, come il resto dello stile Vetro. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/vm_background" />
    <item>
        <shape>
            <gradient
                android:centerX="0.1"
                android:centerY="0"
                android:endColor="#00000000"
                android:gradientRadius="70%p"
                android:startColor="#57FF785A"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:centerX="1"
                android:centerY="0.45"
                android:endColor="#00000000"
                android:gradientRadius="62%p"
                android:startColor="#425A8CFF"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:centerX="0.15"
                android:centerY="1"
                android:endColor="#00000000"
                android:gradientRadius="70%p"
                android:startColor="#47AA5AFF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
