<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/vm_text" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/vm_glass" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/vm_glass_stroke" />
        </shape>
    </item>
</selector>
