<?xml version="1.0" encoding="utf-8"?>
<!-- Finestre di dialogo: vetro scuro con angoli arrotondati. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="16dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/vetro_dialog_background" />
        <stroke
            android:width="1dp"
            android:color="@color/vetro_glass_border" />
        <corners android:radius="24dp" />
    </shape>
</inset>
