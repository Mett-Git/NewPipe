<?xml version="1.0" encoding="utf-8"?>
<!-- Tasto a pillola di vetro, con l'onda al tocco. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/vetro_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vetro_glass" />
            <stroke
                android:width="1dp"
                android:color="@color/vetro_glass_border" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
